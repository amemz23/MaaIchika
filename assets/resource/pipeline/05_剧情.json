    "故事_本集结束": {
        "desc": "认出「章节列表」页 —— **两种版式都要认**。And 两个条件：① 章节号那一列有「第」（ROI [700,110,120,520]，两种列表都是 0.998，剧情画面 MISS）；② 顶部有 tab 文案 イベントストーリー/サイドストーリー（活动故事列表）**或** 右上角书签图标（story/story_bookmark.png，主线列表 1.000 / 活动列表 0.994 / 剧情画面 0.31）。只认 tab 会在**主线故事**的列表上失效（那种版式没有 tab），实测因此失败过一次。进来后分叉：有未读角标 → 选未读 继续读；没有 → 无未读 → 回主页。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["第"],
                                "roi": [700, 110, 120, 520]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "Or",
                            "param": {
                                "any_of": [
                                    {
                                        "recognition": {
                                            "type": "OCR",
                                            "param": {
                                                "expected": ["イベントストーリー", "サイドストーリー"],
                                                "roi": [600, 60, 680, 70]
                                            }
                                        }
                                    },
                                    {
                                        "recognition": {
                                            "type": "TemplateMatch",
                                            "param": {
                                                "template": ["story/story_bookmark.png"],
                                                "roi": [700, 0, 580, 110],
                                                "threshold": 0.9
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": ["[JumpBack]公共_通信错误", "故事_选未读", "故事_无未读", "[JumpBack]公共_回主页", "公共_主页锚点"],
        "max_hit": 5
    },
    "故事_盲点推进": {
        "desc": "剧情里有些过渡帧（场景切换、白闪）⋯ 圆钮、AUTO 文字、黑边**全都不在**，这时 故事_连点 会识别失败。但剧情画面的游戏机制是「点画面任意位置都能推进对白」，所以这里做一次盲点点击是安全的。【允许盲点】理由：剧情上下文里点击不会暂停也不会跳过（加速/跳过只有 ⋯ 菜单里才有），等价于人手指点继续。max_hit 200 兜住，next 回到 故事_连点 继续用锚点判断。",
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 470, 1, 1]
            }
        },
        "rate_limit": 1200,
        "max_hit": 200,
        "next": ["故事_连点"]
    },
    "故事_续读": {
        "desc": "剧情首页右侧推荐卡上的「続きから読む」徽章 —— 有阅读进度的故事才会带它，点它等于续读那一本。识别用 OCR（实测首页 1.000；剧情播放页 / 章节列表页都 MISS）。点开后一般回到那本的章节列表，交给 故事_本集结束 → 故事_选未读 继续读；也可能直接续播，所以 next 里也放着 故事_连点。多个徽章时取最上面那个（先读活动、再读主线），读完再跑一次会挑下一本。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["続きから読む", "続きから"],
                "roi": [960, 140, 320, 560]
            }
