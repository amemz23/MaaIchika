{
    "主页_进任务": {
        "desc": "主页右上角的「ミッション」剪贴板图标（礼物盒下方、☰ 左边，带红点数字）。模板 home/mission_icon.png：主页实测 1.000，剧情画面 0.229（不会误命中）。进页后先看「ライブ」tab 的按钮是白（还能领）还是灰（领完了）。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["home/mission_icon.png"],
                "roi": [1150, 170, 130, 140],
                "threshold": 0.9
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "max_hit": 4,
        "next": [
            "[JumpBack]公共_通信错误",
            "[JumpBack]公共_等待加载",
            "主页_进任务",
            "任务_奖励_一括_ライブ",
            "任务_奖励_ライブ已领完"
        ]
    },
    "任务_奖励_确认": {
        "desc": "领取确认弹窗（はい/受け取る/OK）。用 [JumpBack] 引用：点完回到父节点继续下一步。**注意：真机实测「一括受け取り」在四个 tab 上都是直接领取、不弹确认框**（领完中间只出一个「報酬を獲得しました。」/「称号を獲得しました。」的 toast，没有按钮）；这个节点保留当兜底，别当成主路径 —— 真正判断「还能不能领」的是 任务_奖励_一括_* 里的白底颜色识别。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["はい", "受け取る", "OK"],
                "roi": [300, 380, 680, 200]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 6000,
        "max_hit": 5,
        "next": ["[JumpBack]公共_通信错误", "[JumpBack]公共_等待加载", "任务_奖励_确认"]
    },
