{
    "主页_进演出": {
        "desc": "主页底部导航「ライブ」，进 LIVE 菜单",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["home/nav_live.png"],
                "roi": [1060, 590, 200, 130],
                "threshold": 0.72
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "主页_进演出", "演出_进单人"],
        "max_hit": 4
    },
    "演出_进单人": {
        "desc": "LIVE 菜单「ひとりでライブ」卡片（单人演出，消耗 Live Bonus）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/solo_card.png"],
                "roi": [600, 120, 260, 240],
                "threshold": 0.64
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "演出_进单人", "演出_选曲确认"],
        "max_hit": 4
    },
    "演出_选曲确认": {
        "desc": "选曲页右下「決定」。之后优先走「齿轮 → オートライブ回数 → 決定」开 AUTO —— 实测这条 Click 路线在清火链上稳定命中（OCR 0.993），比拖拽可靠；拖拽只作为最后的兜底",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/decide_btn.png"],
                "roi": [900, 540, 300, 120],
                "threshold": 0.67
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 40000,
        "next": [
            "[JumpBack]公共_等待加载",
            "演出_选曲确认",
            "挑战_今日已结束",
            "演出_开自动设置",
            "演出_确认AUTO",
            "演出_打开AUTO"
        ],
        "max_hit": 4
    },
    "演出_打开AUTO": {
        "desc": "编成页底部 AUTO 开关 —— **拖拽开关，点击无效**。实测 Maa 的 Swipe/TouchDown-Move-Up 都不触发，只有 adb 的 input swipe 有效；而 Shell 动作默认 shell_timeout 可能太短（把 700ms 的滑动掐断），这里显式给 8000ms。⚠️ 命令里的设备像素坐标对应 1440x2560@420 预设（720 坐标 ×2），换预设要同步改",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/auto_off.png"],
                "roi": [480, 620, 220, 90],
                "threshold": 0.78
            }
        },
        "action": {
            "type": "TouchDown",
            "param": {
                "target": [530, 665, 1, 1],
                "contact": 0,
                "pressure": 100
            }
        },
        "timeout": 20000,
        "next": ["演出_拖到ON"],
        "max_hit": 1,
        "rate_limit": 600
    },
    "演出_开演": {
        "desc": "编成页右侧圆形播放按钮。点下去就开始演出（Live Bonus 由游戏按当前设置扣）。开演后由「等待结束」继续盯着：万一这一下被过渡动画吞了，那边还会把它当候选再点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/play_btn.png"],
                "roi": [920, 460, 220, 200],
                "threshold": 0.78
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "演出_开演", "演出_等待结束"],
        "max_hit": 8
    },
    "演出_等待结束": {
        "desc": "演出期间的等待：DirectHit 什么也不做，只看 next 有没有结束信号（LIVE CLEAR / 结算按钮 / 两块挑战面板）。实测：即使编成页设了「オートライブ回数 → ライブボーナスがなくなるまで」，游戏也只打一场就回主页 —— 所以「循环清火」不靠游戏，靠把 任务_清火 排多次（MXU 里重复添加，或 node tools/run.mjs 任务_清火 任务_清火 …）",
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 900,
        "timeout": 420000,
        "next": [
            "[JumpBack]公共_等待加载",
            "演出_结算开场",
            "[JumpBack]演出_阶段面板",
            "演出_结算",
            "演出_开演",
            "演出_打开AUTO",
            "公共_主页锚点"
        ],
        "on_error": ["演出_点屏幕", "公共_失败"]
    },
    "演出_结算开场": {
        "desc": "LIVE CLEAR! 大字（OCR 认，roi 必须盖住 y250-410 这行字）。刚结束的 1-2 秒会播结束动画、点击被吞；实测有时连点 5~8 次才过，所以 max_hit 放到 16、rate_limit 1000、timeout 45s —— 点不动就多试，画面一变就不再命中",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["LIVE CLEAR", "LIVEクリア", "LIVE クリア"],
                "roi": [60, 180, 1000, 340]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 400, 1, 1]
            }
        },
        "timeout": 45000,
        "next": ["[JumpBack]公共_等待加载", "演出_结算开场", "演出_结算"],
        "max_hit": 16,
        "rate_limit": 1000
    },
    "演出_点屏幕": {
        "desc": "兜底：LIVE CLEAR 的 OCR 没认出来时，点一下画面中间也能过。【允许盲点】理由：它只在「演出_等待结束」的 on_error 里被调用，此时能确认的是演出已经超时未给结束信号；点中间在演出中也不会暂停/影响成绩，所以这一次盲点点击是可接受、且比整条任务失败更好的选择。",
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 400, 1, 1]
            }
        },
        "max_hit": 6,
        "next": ["演出_结算", "演出_结算开场"]
    },
    "演出_结算": {
        "desc": "结算多页：底部「次へ」/「OK」/「画面を閉じる」逐页点掉。只认这几个文案 —— 绝不点「通信開始」（上传成绩）。on_error 落到「演出_点屏幕」兜底：万一冒出一块没被枚举到的「点一下继续」浮层，点中间也能过，不会整条任务失败",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["次へ", "OK", "画面を閉じる"],
                "roi": [0, 600, 1280, 120]
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 600,
        "timeout": 12000,
        "max_hit": 30,
        "next": [
            "[JumpBack]公共_等待加载",
            "[JumpBack]演出_阶段面板",
            "演出_结算",
            "[JumpBack]公共_点一下",
            "[JumpBack]公共_回主页",
            "公共_主页锚点"
        ],
        "on_error": ["演出_点屏幕", "公共_失败"]
    },
    "演出_确认AUTO": {
        "desc": "验证 AUTO 真的打开了：认 ON 态（粉底白钮 + ON，实测 0.354/1.000 分离）。确认了才允许点开演 —— 宁可多一步，也不要打一场 0 分的live",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/auto_on.png"],
                "roi": [480, 620, 220, 90],
                "threshold": 0.85
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 8000,
        "next": ["演出_开演", "演出_打开AUTO"],
        "on_error": ["演出_开演"]
    },
    "演出_拖到ON": {
        "desc": "AUTO 拖拽的中间步骤（TouchMove 到右侧）。【允许盲点】理由：它是「TouchDown → TouchMove → TouchUp」手势链的一部分，起点由 演出_打开AUTO 的 OFF 态识别保证，终点固定，本身不需要再识别；整条拖拽是否成功由 演出_确认AUTO 认 ON 态验证。",
        "action": {
            "type": "TouchMove",
            "param": {
                "target": [620, 665, 1, 1],
                "contact": 0,
                "pressure": 100
            }
        },
        "next": ["演出_松手"]
    },
    "演出_松手": {
        "desc": "AUTO 拖拽的最后一步（TouchUp）。【允许盲点】理由：同 演出_拖到ON —— 手指已经按下，必须抬起，没有识别与否的余地；结果由 演出_确认AUTO 验证。",
        "action": {
            "type": "TouchUp",
            "param": {
                "contact": 0
            }
        },
        "next": ["[JumpBack]公共_等待加载", "演出_确认AUTO"]
    },
    "演出_开自动设置": {
        "desc": "备用路径：编成页齿轮 →「オートライブ回数」→ 決定。主路径是拖拽（演出_打开AUTO），因为实测拖拽成功过；齿轮这条路一次能开、一次没变，只当兜底",
