{
    "主页_进演出": {
        "desc": "主页底部导航「ライブ」，进 LIVE 菜单",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["home/nav_live.png"],
                "roi": [1060, 590, 200, 130],
                "threshold": 0.72
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "主页_进演出", "演出_进单人"],
        "max_hit": 4
    },
    "演出_进单人": {
        "desc": "LIVE 菜单「ひとりでライブ」卡片（单人演出，消耗 Live Bonus）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/solo_card.png"],
                "roi": [600, 120, 260, 240],
                "threshold": 0.64
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "演出_进单人", "演出_选曲确认"],
        "max_hit": 4
    },
    "演出_选曲确认": {
        "desc": "选曲页右下「決定」（默认选中列表第一个高亮谱面，不额外选歌 —— 选曲不是这个工具要做的事）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/decide_btn.png"],
                "roi": [900, 540, 300, 120],
                "threshold": 0.67
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 40000,
        "next": ["[JumpBack]公共_等待加载", "演出_选曲确认", "演出_开自动设置", "演出_打开AUTO", "演出_确认AUTO"],
        "max_hit": 4
    },
    "演出_打开AUTO": {
        "desc": "编成页底部 AUTO 开关 —— **拖拽开关，点击无效**。实测 Maa 的 Swipe/TouchDown-Move-Up 都不触发，只有 adb 的 input swipe 有效；而 Shell 动作默认 shell_timeout 可能太短（把 700ms 的滑动掐断），这里显式给 8000ms。⚠️ 命令里的设备像素坐标对应 1440x2560@420 预设（720 坐标 ×2），换预设要同步改",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/auto_off.png"],
                "roi": [480, 620, 220, 90],
                "threshold": 0.78
            }
        },
        "action": {
            "type": "TouchDown",
            "param": {
                "target": [530, 665, 1, 1],
                "contact": 0,
                "pressure": 100
            }
        },
        "timeout": 20000,
        "next": ["演出_拖到ON"],
        "max_hit": 1,
        "rate_limit": 600
    },
    "演出_开演": {
        "desc": "编成页右侧圆形播放按钮。点下去就开始演出（Live Bonus 由游戏按当前设置扣）。开演后由「等待结束」继续盯着：万一这一下被过渡动画吞了，那边还会把它当候选再点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/play_btn.png"],
                "roi": [920, 460, 220, 200],
                "threshold": 0.78
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "演出_开演", "演出_等待结束"],
        "max_hit": 8
    },
    "演出_等待结束": {
        "desc": "演出期间的等待：DirectHit 什么也不做，只看 next 里有没有「打完了」的信号。为什么不认「演出中」的锚点 —— 演出特效会把右下角 AUTO LIVE 胶囊盖掉（实测最低只剩 0.41 分），拿它当锚点会在半场误判结束。next 里留着 开演/打开AUTO：编成页的点击被过渡动画吞掉时，这里会重试",
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 900,
        "timeout": 420000,
        "next": [
            "[JumpBack]公共_等待加载",
            "演出_结算开场",
            "演出_结算",
            "演出_开演",
            "演出_打开AUTO",
            "公共_主页锚点"
        ],
        "on_error": ["演出_点屏幕", "公共_失败"]
    },
    "演出_结算开场": {
        "desc": "LIVE CLEAR! 大字（OCR 认）。roi 必须盖住这行字本身（大约 y 250-410）。演出刚结束的 1-2 秒内会播结束动画、期间的点击会被吞，所以这里 max_hit 8 + rate_limit 1200：点不动就多试几次，画面一变就不再命中",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["LIVE CLEAR", "LIVEクリア", "LIVE クリア"],
                "roi": [60, 180, 1000, 340]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 400, 1, 1]
            }
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "演出_结算开场", "演出_结算"],
        "max_hit": 8,
        "rate_limit": 1200
    },
    "演出_点屏幕": {
        "desc": "兜底：万一 LIVE CLEAR 没被认出来，点一下画面中间也能过（演出中这一下不会暂停，不影响成绩）",
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 400, 1, 1]
            }
        },
        "max_hit": 2,
        "next": ["演出_结算", "演出_结算开场"]
    },
    "演出_结算": {
        "desc": "结算多页：底部的「次へ」/「OK」/「画面を閉じる」逐页点掉。只认这几个文案 —— 绝不点「通信開始」（那是上传成绩）。结算完游戏会回到 **LIVE 菜单**而不是主页，所以 next 里要跟一个「回主页」",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["次へ", "OK", "画面を閉じる"],
                "roi": [0, 600, 1280, 120]
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 600,
        "timeout": 20000,
        "max_hit": 30,
        "next": ["[JumpBack]公共_等待加载", "演出_结算", "[JumpBack]公共_回主页", "公共_主页锚点"]
    },
    "演出_确认AUTO": {
        "desc": "验证 AUTO 真的打开了：认 ON 态（粉底白钮 + ON，实测 0.354/1.000 分离）。确认了才允许点开演 —— 宁可多一步，也不要打一场 0 分的live",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/auto_on.png"],
                "roi": [480, 620, 220, 90],
                "threshold": 0.85
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 8000,
        "next": ["演出_开演", "演出_打开AUTO"],
        "on_error": ["演出_开演"]
    },
    "演出_拖到ON": {
        "desc": "把 AUTO 旋钮从左侧拖到右侧（中间步骤）",
        "action": {
            "type": "TouchMove",
            "param": {
                "target": [620, 665, 1, 1],
                "contact": 0,
                "pressure": 100
            }
        },
        "next": ["演出_松手"]
    },
    "演出_松手": {
        "desc": "抬起触点，完成拖拽",
        "action": {
            "type": "TouchUp",
            "param": {
                "contact": 0
            }
        },
        "next": ["[JumpBack]公共_等待加载", "演出_确认AUTO"]
    },
    "演出_开自动设置": {
        "desc": "编成页底部齿轮（AUTO 开关右侧），打开「オートライブ回数」对话框。这条路全是 Click（可靠通道）：齿轮 1 次有效、对话框決定 1 次有效，但**游戏是否因此把 AUTO 打开还不稳定**（同一操作一次 ON 一次没变），所以后面还要「确认AUTO」验证，失败了再退到拖拽路径",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/auto_off.png"],
                "roi": [480, 620, 220, 90],
                "threshold": 0.83
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [655, 665, 1, 1]
            }
        },
        "timeout": 15000,
        "max_hit": 2,
        "next": ["[JumpBack]公共_等待加载", "演出_自动设置决定"]
    },
    "演出_自动设置决定": {
        "desc": "「オートライブ回数」对话框 —— 用里面的两个单选项文案识别（标题「オートライブ回数」OCR 读不出来，实测 MISS；「ライブボーナスがなくなるまで」0.982 命中）。点右下「決定」= 保持「体力用完为止」+ 不勾任何消费道具，游戏会自动把 AUTO 打开",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["ライブボーナスがなくなるまで", "回数を指定"],
                "roi": [100, 60, 760, 120]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [726, 638, 1, 1]
            }
        },
        "timeout": 15000,
        "max_hit": 2,
        "next": ["[JumpBack]公共_等待加载", "演出_确认AUTO"]
    }
}
