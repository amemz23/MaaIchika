    "故事_勾连读": {
        "desc": "语音弹窗里「次のストーリーを連続で読む」的复选框。用「未勾选」当模板：勾上后不再匹配，天然只勾一次 **max_hit 必须够大**：每读一集都要勾一次，原来写 2，读到第 3 集就被框架移出候选、链路卡在语音弹窗（真机 428s / 590s 两次失败都是这个）。",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["story/continue_box.png"],
                "roi": [440, 430, 140, 110],
                "threshold": 0.85
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 15000,
        "max_hit": 40,
        "next": ["[JumpBack]公共_等待加载", "故事_选语音"]
    },
    "故事_选语音": {
        "desc": "语音选择弹窗的「ボイスなし」按钮。**两种版式**都要认：旧版是横向三按钮（ボイスなし / ダウンロード / キャンセル），新版是「ボイスデータをダウンロードして、ストーリーを読みますか？」下面「ボイスなし / ボイスあり」两个按钮 —— 新版把 ボイスなし 挪到了左半边，旧 ROI [500,500,320,90] 只框到按钮一角，点下去会落空（真机踩到）。现在 ROI [340,460,600,150] 两种版式都能框全，点击用识别框中心（文字居中于按钮）。 **max_hit 同理**：每集开始都会问一次语音，原来写 2 会在第 3 集卡死。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["ボイスなし"],
                "roi": [340, 460, 600, 150]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 20000,
        "max_hit": 40,
        "next": [
            "[JumpBack]公共_下载中",
            "[JumpBack]公共_追加数据",
            "[JumpBack]公共_领登录奖励",
            "[JumpBack]公共_关公告",
            "[JumpBack]公共_等待加载",
            "故事_选语音",
            "故事_连点"
        ]
    },
    "故事_连点": {
        "desc": "剧情里纯点击推进。next 必须保持短：这个节点每秒跑一轮，每多一个候选就多一次识别（OCR 候选约 0.3-0.5s）。实测挂 5 个通用处理节点（含 2 个 OCR）后，单轮点击从 ~0.8s 掉到 ~3s，一集剧情从 15 分钟变成 1 小时。所以这里只留最便宜的「等待加载（模板）」和出口「本集结束」；追加数据/登录奖励那些 OCR 处理只挂在剧情入口节点上（实测这些弹窗只在外层界面出现）。锚点三个：右上角 ⋯（对白画面 0.93+）、右下角 AUTO 文字、纯黑边（旁白画面实测 104000 px 全黑）。 识别不到时由 on_error 落到 故事_盲点推进（剧情里点任意位置都能继续），不会整条任务失败。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": ["story/menu_dots.png"],
                                "roi": [1180, 0, 100, 90],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["AUTO"],
                                "roi": [1080, 640, 200, 70]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "method": 6,
                                "lower": [0],
                                "upper": [16],
                                "roi": [120, 20, 1040, 100],
                                "count": 60000,
                                "connected": true
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 470, 1, 1]
            }
        },
        "rate_limit": 700,
        "timeout": 4000,
        "max_hit": 4000,
        "next": ["[JumpBack]公共_通信错误", "[JumpBack]公共_等待加载", "故事_连点", "故事_本集结束"],
        "on_error": ["故事_盲点推进"]
    },
