{
    "公共_等待加载": {
        "desc": "加载中。锚点是右下角「初音头像 + 三个点」。next 故意留空：Maa 只在该节点 next 为空时才 [JumpBack] 回父节点，父节点重扫时会再命中它 —— 轮询就是这么来的。max_hit 300 × ~600ms 足够覆盖两分钟加载",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["common/loading_miku.png"],
                "roi": [1100, 560, 180, 160],
                "threshold": 0.68
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 400,
        "max_hit": 300,
        "next": []
    },
    "公共_关公告": {
        "desc": "公告 / 通知面板右上角的 X。直接点识别框中心，不写死坐标。阈值 0.72 是实测出来的：同一个 X 在「通知列表」面板上只有 0.787（另一面板 1.000），而别的画面的天花板是 0.604",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["common/notice_close.png"],
                "roi": [1040, 0, 240, 130],
                "threshold": 0.72
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 400,
        "max_hit": 30
    },
    "公共_Google登录": {
        "desc": "Google Play 重新登录弹窗（com.google.android.gms 的 ConsentActivity，独立系统 Activity、受保护窗口）。**它会在启动过程中第二次出现**，而且垂直位置会上下偏（实测同一弹窗的标题在 y≈57 和 y≈114 都出现过），所以 ROI 放宽到 [180,16,920,240]。收不到注入按键 → 用 Shell 跑 adb input keyevent 4",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["使用 Google 账号登录", "Google アカウントでログイン", "Sign in with Google"],
                "roi": [180, 16, 920, 240]
            }
        },
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "input keyevent 4"
            }
        },
        "rate_limit": 500,
        "max_hit": 4
    },
    "公共_回主页": {
        "desc": "点左上角返回箭头。next 留空 → 点完 [JumpBack] 回父节点；父节点重扫时如果箭头还在就再点一次。max_hit 8 防止在点不动的界面上死循环",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["common/back_arrow.png"],
                "roi": [0, 0, 140, 110],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 500,
        "timeout": 2500,
        "max_hit": 8,
        "next": []
    },
    "公共_主页锚点": {
        "desc": "主页锚点：底部导航「ガチャ」图标。这是所有任务的**成功终止节点** —— 只在这个元素真的出现时才结束，不用\"next 跑空=成功\"这种假象",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["home/nav_gacha.png"],
                "roi": [300, 580, 260, 140],
                "threshold": 0.66
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": []
    },
    "公共_失败": {
        "desc": "兜底失败：明确杀掉任务，让前端和日志里看得见\"失败\"，而不是静默结束",
        "action": {
            "type": "StopTask"
        }
    },
    "公共_领登录奖励": {
        "desc": "登录奖励 / 活动登录奖励的领取画面（「報酬を獲得しました。」+ GET! 卡片，OCR 实测 1.000，主页 MISS）。点一下继续 —— 可能连着好几页，所以 next 留空靠父节点重扫：[JumpBack] 引用它就会一页一页点完再回主流程",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["報酬を獲得しました", "報酬を受け取りました"],
                "roi": [100, 380, 900, 120]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 250, 1, 1]
            }
        },
        "timeout": 15000,
        "max_hit": 12,
        "next": []
    },
    "公共_追加数据": {
        "desc": "新一天/更新后启动会问「追加データ264MBをダウンロードしますか？」。**必须点「ダウンロード」** —— 实测点「キャンセル」会让游戏退回标题页，形成「标题点击 → 追加数据 → Google 登录 → 标题」的死循环，永远进不去。下载的只是追加素材（MV/语音等），不影响账号与货币",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["追加データ", "ダウンロードします"],
                "roi": [200, 250, 900, 140]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [759, 539, 1, 1]
            }
        },
        "timeout": 30000,
        "max_hit": 10,
        "next": []
    },
    "公共_下载中": {
        "desc": "追加数据下载进度页（「データダウンロード中 12.61%」）。命中就什么也不做，[JumpBack] 回父节点轮询 —— 等的是它消失。max_hit 600 × ~1.5s ≈ 15 分钟上限",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["データダウンロード中"],
                "roi": [0, 600, 700, 80]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 1500,
        "max_hit": 600,
        "next": []
    },
    "公共_点一下": {
        "desc": "在结算/结果页点一下画面中间。【允许盲点】理由：结算页有种过渡态是「内容已出现但次へ/OK 还没出现」，只能点一下把它推出来；它只被放进结算上下文（演出_结算、任务_收尾结算）的 next 末尾，命中后会 [JumpBack] 回父节点重扫，max_hit 10 兜住。演出过程中不会用它（那样会每秒空点）。",
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 400, 1, 1]
            }
        },
        "max_hit": 10,
        "next": []
    },
    "公共_体力为0": {
        "desc": "顶部「ライブボーナス」确实是 0/25 时命中。**不能用纯 OCR，也不能用整个 0/25 的模板** —— OCR 是子串匹配（40/25、10/25 都命中，实测 40/25 得 0.974）；整串模板会被 10/25 的视觉子串命中（1.000）。现在 And 两个：① 首位数字「0」的窄模板（实测 0/25=1.000、10/25=0.871、40/25=0.529、2/25=0.563、1/25=0.493，阈值 0.93）；② OCR 兜底「0/25」。体力为 0 时编成页播放按钮是灰的、点不动，所以这是正常结束状态：回主页收尾。两条硬约束：① 只在演出链路里引用；② 不能用 [JumpBack] 引用（到主页也会命中，会空转）。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": ["common/bonus_zero_first.png"],
                                "roi": [1030, 20, 110, 45],
                                "threshold": 0.93
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["0/25"],
                                "roi": [1000, 15, 240, 60]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 15000,
        "next": ["[JumpBack]公共_回主页", "公共_主页锚点"],
        "max_hit": 10
    },
    "公共_通信错误": {
        "desc": "「通信エラーが発生しました。」居中白框 + OK 按钮。实测在剧情读到一半时出现。识别文案 + 点那个 OK（Action 用识别框中心）。⚠️ 这里的 OK 是**网络错误提示的确认**，不是 AGENTS 禁掉的「通信開始」（上传成绩）。用 [JumpBack] 引用：点掉后对话框消失，自然不再命中；max_hit 3 兜底。",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["通信エラー"],
                "roi": [300, 230, 680, 120]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [430, 390, 420, 80]
            }
        },
        "timeout": 12000,
        "max_hit": 20,
        "next": []
    }
}
