    "故事_连点": {
        "desc": "剧情里纯点击推进。next 必须保持短：这个节点每秒跑一轮，每多一个候选就多一次识别（OCR 候选约 0.3-0.5s）。实测挂 5 个通用处理节点（含 2 个 OCR）后，单轮点击从 ~0.8s 掉到 ~3s，一集剧情从 15 分钟变成 1 小时。所以这里只留最便宜的「等待加载（模板）」和出口「本集结束」；追加数据/登录奖励那些 OCR 处理只挂在剧情入口节点上（实测这些弹窗只在外层界面出现）。锚点三个：右上角 ⋯（对白画面 0.93+）、右下角 AUTO 文字、纯黑边（旁白画面实测 104000 px 全黑）。 识别不到时由 on_error 落到 故事_盲点推进（剧情里点任意位置都能继续），不会整条任务失败。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": ["story/menu_dots.png"],
                                "roi": [1180, 0, 100, 90],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["AUTO"],
                                "roi": [1080, 640, 200, 70]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "method": 6,
                                "lower": [0],
                                "upper": [16],
                                "roi": [120, 20, 1040, 100],
                                "count": 60000,
                                "connected": true
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 470, 1, 1]
            }
        },
        "rate_limit": 700,
        "timeout": 4000,
        "max_hit": 4000,
        "next": ["[JumpBack]公共_等待加载", "故事_连点", "故事_本集结束"],
        "on_error": ["故事_盲点推进"]
    },
    "故事_无未读": {
        "desc": "章节列表里没有未读角标了：这本故事读完了。什么都不做，交给上层去收尾",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["第1話", "第2話", "第3話", "第4話", "第5話"],
                "roi": [640, 60, 640, 200]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": ["[JumpBack]公共_回主页", "公共_主页锚点"]
    },
    "故事_本集结束": {
        "desc": "一集读完回到章节列表（勾了「連続で読む」时会自动接下一集，那时不会命中这里）。命中后先继续找未读章节；如果列表里已经没有未读角标，就回主页收尾 —— 否则任务链会在「没有未读」这种情况下跑空、被判「结束但未验证」",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["第1話", "第2話", "第3話"],
                "roi": [640, 60, 640, 200]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": ["故事_选未读", "[JumpBack]公共_回主页", "公共_主页锚点"]
    },
    "故事_盲点推进": {
        "desc": "剧情里有些过渡帧（场景切换、白闪）⋯ 圆钮、AUTO 文字、黑边**全都不在**，这时 故事_连点 会识别失败。但剧情画面的游戏机制是「点画面任意位置都能推进对白」，所以这里做一次盲点点击是安全的。【允许盲点】理由：剧情上下文里点击不会暂停也不会跳过（加速/跳过只有 ⋯ 菜单里才有），等价于人手指点继续。max_hit 200 兜住，next 回到 故事_连点 继续用锚点判断。",
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 470, 1, 1]
            }
        },
        "rate_limit": 1200,
        "max_hit": 200,
        "next": ["故事_连点"]
    }
}
