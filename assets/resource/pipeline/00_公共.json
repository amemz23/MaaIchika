{
    "公共_等待加载": {
        "desc": "加载中。锚点是右下角「初音头像 + 三个点」。next 故意留空：Maa 只在该节点 next 为空时才 [JumpBack] 回父节点，父节点重扫时会再命中它 —— 轮询就是这么来的。max_hit 300 × ~600ms 足够覆盖两分钟加载",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["common/loading_miku.png"],
                "roi": [1100, 560, 180, 160],
                "threshold": 0.68
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 400,
        "max_hit": 300,
        "next": []
    },
    "公共_关公告": {
        "desc": "公告 / 通知面板右上角的 X。直接点识别框中心，不写死坐标。阈值 0.72 是实测出来的：同一个 X 在「通知列表」面板上只有 0.787（另一面板 1.000），而别的画面的天花板是 0.604",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["common/notice_close.png"],
                "roi": [1040, 0, 240, 130],
                "threshold": 0.72
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 400,
        "max_hit": 3
    },
    "公共_Google登录": {
        "desc": "Google Play 重新登录弹窗（com.google.android.gms 的 ConsentActivity，独立系统 Activity、受保护窗口）。**它会在启动过程中第二次出现**，而且垂直位置会上下偏（实测同一弹窗的标题在 y≈57 和 y≈114 都出现过），所以 ROI 放宽到 [180,16,920,240]。收不到注入按键 → 用 Shell 跑 adb input keyevent 4",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["使用 Google 账号登录", "Google アカウントでログイン", "Sign in with Google"],
                "roi": [180, 16, 920, 240]
            }
        },
        "action": {
            "type": "Shell",
            "param": {
                "cmd": "input keyevent 4"
            }
        },
        "rate_limit": 500,
        "max_hit": 4
    },
    "公共_回主页": {
        "desc": "点左上角返回箭头。next 留空 → 点完 [JumpBack] 回父节点；父节点重扫时如果箭头还在就再点一次。max_hit 8 防止在点不动的界面上死循环",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["common/back_arrow.png"],
                "roi": [0, 0, 140, 110],
                "threshold": 0.8
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 500,
        "timeout": 2500,
        "max_hit": 8,
        "next": []
    },
    "公共_主页锚点": {
        "desc": "主页锚点：底部导航「ガチャ」图标。这是所有任务的**成功终止节点** —— 只在这个元素真的出现时才结束，不用\"next 跑空=成功\"这种假象",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["home/nav_gacha.png"],
                "roi": [300, 580, 260, 140],
                "threshold": 0.66
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": []
    },
    "公共_失败": {
        "desc": "兜底失败：明确杀掉任务，让前端和日志里看得见\"失败\"，而不是静默结束",
        "action": {
            "type": "StopTask"
        }
    },
    "公共_领登录奖励": {
        "desc": "登录奖励 / 活动登录奖励的领取画面（「報酬を獲得しました。」+ GET! 卡片，OCR 实测 1.000，主页 MISS）。点一下继续 —— 可能连着好几页，所以 next 留空靠父节点重扫：[JumpBack] 引用它就会一页一页点完再回主流程",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["報酬を獲得しました", "報酬を受け取りました"],
                "roi": [100, 380, 900, 120]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 250, 1, 1]
            }
        },
        "timeout": 15000,
        "max_hit": 12,
        "next": []
    },
    "公共_追加数据": {
        "desc": "新一天/更新后启动会问「追加データ264MBをダウンロードしますか？」。**必须点「ダウンロード」** —— 实测点「キャンセル」会让游戏退回标题页，形成「标题点击 → 追加数据 → Google 登录 → 标题」的死循环，永远进不去。下载的只是追加素材（MV/语音等），不影响账号与货币",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["追加データ", "ダウンロードします"],
                "roi": [200, 250, 900, 140]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [759, 539, 1, 1]
            }
        },
        "timeout": 30000,
        "max_hit": 2,
        "next": []
    },
    "公共_下载中": {
        "desc": "追加数据下载进度页（「データダウンロード中 12.61%」）。命中就什么也不做，[JumpBack] 回父节点轮询 —— 等的是它消失。max_hit 600 × ~1.5s ≈ 15 分钟上限",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["データダウンロード中"],
                "roi": [0, 600, 700, 80]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 1500,
        "max_hit": 600,
        "next": []
    }
}
