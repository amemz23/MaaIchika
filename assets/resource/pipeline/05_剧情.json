    "故事_连点": {
        "desc": "剧情里纯点击推进。锚点三个：① 右上角 ⋯ 圆钮（对白画面，实测 0.93+）② 右下角 AUTO 文字 ③ 黑边（旁白/演出画面会隐藏 ⋯ 和 AUTO，那时上下是纯黑边，实测 104000 px 全黑）—— 单靠 ⋯ 会在旁白画面断链。点的是画面中间偏下。**不用 オート/早送り/スキップ**：活动剧情跳过就不给水晶",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": ["story/menu_dots.png"],
                                "roi": [1180, 0, 100, 90],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["AUTO"],
                                "roi": [1080, 640, 200, 70]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "method": 6,
                                "lower": [0],
                                "upper": [16],
                                "roi": [120, 20, 1040, 100],
                                "count": 60000,
                                "connected": true
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 470, 1, 1]
            }
        },
        "rate_limit": 700,
        "timeout": 4000,
        "max_hit": 4000,
        "next": [
            "[JumpBack]公共_等待加载",
            "[JumpBack]公共_下载中",
            "[JumpBack]公共_追加数据",
            "[JumpBack]公共_领登录奖励",
            "[JumpBack]公共_关公告",
            "故事_连点",
            "故事_本集结束"
        ],
        "recognitions_hint": "见 desc"
    },
