{
    "主页_进演出": {
        "desc": "主页底部导航「ライブ」，进 LIVE 菜单",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["home/nav_live.png"],
                "roi": [1060, 590, 200, 130],
                "threshold": 0.72
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "主页_进演出", "演出_进单人"],
        "max_hit": 4
    },
    "演出_进单人": {
        "desc": "LIVE 菜单「ひとりでライブ」卡片（单人演出，消耗 Live Bonus）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/solo_card.png"],
                "roi": [600, 120, 260, 240],
                "threshold": 0.64
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "演出_进单人", "演出_选曲确认"],
        "max_hit": 4
    },
    "演出_选曲确认": {
        "desc": "选曲页右下「決定」（默认选中列表第一个高亮谱面，不额外选歌 —— 选曲不是这个工具要做的事）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/decide_btn.png"],
                "roi": [900, 540, 300, 120],
                "threshold": 0.67
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 40000,
        "next": ["[JumpBack]公共_等待加载", "演出_选曲确认", "演出_打开AUTO", "演出_确认AUTO"],
        "max_hit": 4
    },
    "演出_打开AUTO": {
        "desc": "编成页底部 AUTO 开关。用「OFF 态」当模板。⚠️ 实测这个开关的点击**不可靠**：本轮一次成功（l07 拍到 ON）、之后在旋钮/中央/标签三个位置点+滑都不生效。所以这里最多试 2 次就交给「确认AUTO」的 on_error 兜底，宁可少点也不要把流程卡死。根源待查（可试：live 内暂停菜单开 AUTO，或游戏内オートライブ设置）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/auto_off.png"],
                "roi": [480, 620, 220, 90],
                "threshold": 0.78
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [22, 21, 0, 0]
            }
        },
        "timeout": 20000,
        "next": ["[JumpBack]公共_等待加载", "演出_打开AUTO", "演出_确认AUTO"],
        "max_hit": 2
    },
    "演出_开演": {
        "desc": "编成页右侧圆形播放按钮。点下去就开始演出（Live Bonus 由游戏按当前设置扣）。开演后由「等待结束」继续盯着：万一这一下被过渡动画吞了，那边还会把它当候选再点",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/play_btn.png"],
                "roi": [920, 460, 220, 200],
                "threshold": 0.78
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "演出_开演", "演出_等待结束"],
        "max_hit": 8
    },
    "演出_等待结束": {
        "desc": "演出期间的等待：DirectHit 什么也不做，只看 next 里有没有「打完了」的信号。为什么不认「演出中」的锚点 —— 演出特效会把右下角 AUTO LIVE 胶囊盖掉（实测最低只剩 0.41 分），拿它当锚点会在半场误判结束。next 里留着 开演/打开AUTO：编成页的点击被过渡动画吞掉时，这里会重试",
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 900,
        "timeout": 420000,
        "next": [
            "[JumpBack]公共_等待加载",
            "演出_结算开场",
            "演出_结算",
            "演出_开演",
            "演出_打开AUTO",
            "公共_主页锚点"
        ],
        "on_error": ["演出_点屏幕", "公共_失败"]
    },
    "演出_结算开场": {
        "desc": "LIVE CLEAR! 大字（OCR 认）。roi 必须盖住这行字本身（大约 y 250-410）。演出刚结束的 1-2 秒内会播结束动画、期间的点击会被吞，所以这里 max_hit 8 + rate_limit 1200：点不动就多试几次，画面一变就不再命中",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["LIVE CLEAR", "LIVEクリア", "LIVE クリア"],
                "roi": [60, 180, 1000, 340]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 400, 1, 1]
            }
        },
        "timeout": 30000,
        "next": ["[JumpBack]公共_等待加载", "演出_结算开场", "演出_结算"],
        "max_hit": 8,
        "rate_limit": 1200
    },
    "演出_点屏幕": {
        "desc": "兜底：万一 LIVE CLEAR 没被认出来，点一下画面中间也能过（演出中这一下不会暂停，不影响成绩）",
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 400, 1, 1]
            }
        },
        "max_hit": 2,
        "next": ["演出_结算", "演出_结算开场"]
    },
    "演出_结算": {
        "desc": "结算多页：底部的「次へ」/「OK」/「画面を閉じる」逐页点掉。只认这几个文案 —— 绝不点「通信開始」（那是上传成绩）。结算完游戏会回到 **LIVE 菜单**而不是主页，所以 next 里要跟一个「回主页」",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": ["次へ", "OK", "画面を閉じる"],
                "roi": [0, 600, 1280, 120]
            }
        },
        "action": {
            "type": "Click"
        },
        "rate_limit": 600,
        "timeout": 20000,
        "max_hit": 30,
        "next": ["[JumpBack]公共_等待加载", "演出_结算", "[JumpBack]公共_回主页", "公共_主页锚点"]
    },
    "演出_确认AUTO": {
        "desc": "验证 AUTO 真的打开了：认 ON 态（粉底白钮 + ON，实测 0.354/1.000 分离）。确认了才允许点开演 —— 宁可多一步，也不要打一场 0 分的live",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": ["live/auto_on.png"],
                "roi": [480, 620, 220, 90],
                "threshold": 0.85
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 8000,
        "next": ["演出_开演", "演出_打开AUTO"],
        "on_error": ["演出_开演"]
    }
}
