    "故事_连点": {
        "desc": "剧情里纯点击推进。next 必须保持短：这个节点每秒跑一轮，每多一个候选就多一次识别（OCR 候选约 0.3-0.5s）。实测挂 5 个通用处理节点（含 2 个 OCR）后，单轮点击从 ~0.8s 掉到 ~3s，一集剧情从 15 分钟变成 1 小时。所以这里只留最便宜的「等待加载（模板）」和出口「本集结束」；追加数据/登录奖励那些 OCR 处理只挂在剧情入口节点上（实测这些弹窗只在外层界面出现）。锚点三个：右上角 ⋯（对白画面 0.93+）、右下角 AUTO 文字、纯黑边（旁白画面实测 104000 px 全黑）。 识别不到时由 on_error 落到 故事_盲点推进（剧情里点任意位置都能继续），不会整条任务失败。",
        "recognition": {
            "type": "Or",
            "param": {
                "any_of": [
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "template": ["story/menu_dots.png"],
                                "roi": [1180, 0, 100, 90],
                                "threshold": 0.8
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["AUTO"],
                                "roi": [1080, 640, 200, 70]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "ColorMatch",
                            "param": {
                                "method": 6,
                                "lower": [0],
                                "upper": [16],
                                "roi": [120, 20, 1040, 100],
                                "count": 60000,
                                "connected": true
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 470, 1, 1]
            }
        },
        "rate_limit": 700,
        "timeout": 4000,
        "max_hit": 4000,
        "next": ["[JumpBack]公共_通信错误", "[JumpBack]公共_等待加载", "故事_连点", "故事_本集结束"],
        "on_error": ["故事_盲点推进"]
    },
    "故事_无未读": {
        "desc": "章节列表页 + 没有未读角标 = 这一本读完了，什么都不做，交给上层回主页收尾。识别和 故事_本集结束 完全一致（And：章节号「第」+ 顶部 tab 文案），区别只在 next 里的先后：先试 故事_选未读（有未读就继续读），试不到才走到这里。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["第"],
                                "roi": [660, 110, 180, 240]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["イベントストーリー", "サイドストーリー"],
                                "roi": [600, 60, 680, 70]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": ["[JumpBack]公共_通信错误", "[JumpBack]公共_回主页", "公共_主页锚点"]
    },
    "故事_本集结束": {
        "desc": "认出「章节列表」页。**两个条件都要满足**（And）：① 章节号那一列有「第」（ROI [660,110,180,240]）；② 列表顶部有 tab 文案 イベントストーリー / サイドストーリー（ROI [600,60,720,70]，实测列表 0.999/1.000、剧情画面 MISS）。只认「第」会误判：剧情播放时旁白文字偶尔落进那个 ROI，被判成集末 → 去回主页 → 剧情中回不了主页（返回键只推进对白）→ 整条任务失败（真机 590s 踩到过）。进来后是「继续读 vs 收工」的分叉点：有未读角标 → 选未读 继续读；没有 → 无未读 → 回主页。",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["第"],
                                "roi": [660, 110, 180, 240]
                            }
                        }
                    },
                    {
                        "recognition": {
                            "type": "OCR",
                            "param": {
                                "expected": ["イベントストーリー", "サイドストーリー"],
                                "roi": [600, 60, 680, 70]
                            }
                        }
                    }
                ]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": ["[JumpBack]公共_通信错误", "故事_选未读", "故事_无未读", "[JumpBack]公共_回主页", "公共_主页锚点"],
        "max_hit": 5
    },
    "故事_盲点推进": {
        "desc": "剧情里有些过渡帧（场景切换、白闪）⋯ 圆钮、AUTO 文字、黑边**全都不在**，这时 故事_连点 会识别失败。但剧情画面的游戏机制是「点画面任意位置都能推进对白」，所以这里做一次盲点点击是安全的。【允许盲点】理由：剧情上下文里点击不会暂停也不会跳过（加速/跳过只有 ⋯ 菜单里才有），等价于人手指点继续。max_hit 200 兜住，next 回到 故事_连点 继续用锚点判断。",
        "action": {
            "type": "Click",
            "param": {
                "target": [640, 470, 1, 1]
            }
        },
        "rate_limit": 1200,
        "max_hit": 200,
        "next": ["故事_连点"]
    }
}
